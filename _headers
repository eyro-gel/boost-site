# Cloudflare Pages / Netlify header rules.
# CSP is tight because the site has no inline script, no inline style and no
# inline event handlers — verified. The only external origin is Google Fonts.
# img-src allows data: for two CSS background SVGs: the hero's route line and
# the select chevron, which appearance:none removes and this replaces.
# If you self-host the fonts, drop the two fonts.* entries and it becomes 'self' only.

/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; connect-src 'self'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Frame-Options: DENY

# Pages are served as /, /packages/ and /plans/ — always revalidate so copy
# fixes go live immediately. Assets keep the long cache (rule below wins).
/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=604800
